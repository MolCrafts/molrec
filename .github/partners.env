# The partner commits CI builds molrec against -- the ONE place they are
# pinned. .github/workflows/ci.yml reads this file, and so do the git hooks
# (scripts/partners.py), so a local push is judged against the same molrs
# commit as CI, never against whatever ../molrs happens to have checked out.
#
# KEY=VALUE lines only (CI appends them to $GITHUB_ENV). SELF is this
# repository's directory in CI's sibling layout.
#
# Bump MOLRS_REF deliberately, when molrs's adapter surface moves, and relock
# in the same commit: uv.lock records the molcrafts-molrs version this commit
# carries (`scripts/partners.py run -- uv lock`).
SELF=molrec
MOLRS_REPOSITORY=MolCrafts/molrs
MOLRS_REF=4dab9c52fb91f9dc670fa81bf2955f1275c0000f
