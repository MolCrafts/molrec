# The partner repositories molrec is checked against. scripts/partners.py
# resolves them, for the workflows (molcrafts-ci's actions/setup-partners:
# `partners.py fetch`) and for the git hooks (`partners.py run`) alike, so a
# local push is judged against
# the same molrs commit as CI, never against whatever ../molrs happens to have
# checked out.
#
# KEY=VALUE lines only. SELF is this repository's directory in CI's sibling
# layout.
#
# On dev, partners are tracked, not pinned: MOLRS_REF=dev is molrs's dev tip
# -- or molrs's branch of the same name as the one being built, when molrs has
# one (a change spanning both repositories; see "Partners" in CLAUDE.md). A
# release names a tag or commit here instead.
#
# uv.lock records molrs's package metadata (its version and dependencies), not
# a commit. When molrs's dev changes that metadata, `uv lock --check` fails;
# relock in a commit of its own:
#   scripts/partners.py run -- sh -c 'uv lock && cp uv.lock "$PARTNERS_SOURCE/"'
SELF=molrec
MOLRS_REPOSITORY=MolCrafts/molrs
# Pinned while molrs's refactor/atomic-number-species (MolCrafts/molrs#143)
# lands: molcrafts-ci's setup-partners uses the declared ref exactly, with no
# same-named-branch matching. Back to dev once #143 is merged.
MOLRS_REF=e6bf78e20855a07719fca0a6a99436dad56bc4f8
