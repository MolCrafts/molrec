    "detail": {
      "default": "",
      "title": "Detail",
      "type": "string"
    },
    "kind": {
      "enum": [
        "missing_field",
        "missing_key",
        "unexpected_key",
        "missing_values",
        "unexpected_values",
        "wrong_type",
        "wrong_shape",
        "wrong_length",
        "value_mismatch",
        "model_mismatch",
        "not_rejected"
      ],
      "title": "Kind",
      "type": "string"
    },
    "path": {
      "default": "",
      "title": "Path",
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "title": "Violation",
  "type": "object"
}
