{
  "$defs": {
    "ArrayModel": {
      "description": "One typed array of any shape, a 0-d one included.",
      "properties": {
        "dtype": {
          "enum": [
            "f64",
            "i8",
            "i16",
            "i32",
            "i64",
            "u8",
            "u16",
            "u32",
            "u64",
            "bool",
            "string",
            "c64",
            "c128"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "dtype"
      ],
      "title": "ArrayModel",
      "type": "object"
    },
    "ObservableMetaModel": {
      "additionalProperties": true,
      "description": "The ``observables/meta/<name>`` document.\n\n``kind``, ``description`` and ``time_dependent`` are required; the rest\nare written only when set. Every other key is a producer's and is kept\nverbatim (``extra=\"allow\"``).",
      "properties": {
        "axes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Axes"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "sampling": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "time_dependent": {
          "title": "Time Dependent",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "kind",
        "description",
        "time_dependent"
      ],
      "title": "ObservableMetaModel",
      "type": "object"
    },
    "ObservableModel": {
      "description": "One named result: its metadata document and its data array -- the two\nhalves the layout stores side by side.",
      "properties": {
        "data": {
          "$ref": "#/$defs/ArrayModel"
        },
        "meta": {
          "$ref": "#/$defs/ObservableMetaModel"
        }
      },
      "required": [
        "meta",
        "data"
      ],
      "title": "ObservableModel",
      "type": "object"
    }
  },
  "description": "The section: every named observable of the record.",
  "properties": {
    "observables": {
      "additionalProperties": {
        "$ref": "#/$defs/ObservableModel"
      },
      "title": "Observables",
      "type": "object"
    }
  },
  "title": "ObservablesModel",
  "type": "object"
}
