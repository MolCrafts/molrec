  "additionalProperties": true,
  "description": "The record's identity document.\n\n``extra=\"allow\"`` is not convenience -- it is the preserve-the-unknown\ninvariant: a reader must keep keys it does not recognize.\n\nIdentity of a record is the ``*.mrec`` path suffix plus a Zarr root.\n\n``record_id`` and ``content_hash`` are optional provenance, like\n``creator``, ``author``, ``created_at`` and ``source``.",
  "properties": {
    "author": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
