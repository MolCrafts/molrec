{
  "$defs": {
    "ColumnModel": {
      "description": "A typed N-dimensional array.\n\nThe leading axis length is the owning block's count; trailing axes are\nper-entity structure, so ``Float[count][3]`` is one column, not three.",
      "properties": {
        "dtype": {
          "enum": [
            "f16",
            "f32",
            "f64",
            "i8",
            "i16",
            "i32",
            "i64",
            "u8",
            "u16",
            "u32",
            "u64",
            "bool",
            "string",
            "c64",
            "c128"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        },
        "validity": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validity"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "dtype",
        "shape"
      ],
      "title": "ColumnModel",
      "type": "object"
    },
    "MeshModel": {
      "description": "Voxel edges of a regular grid, the geometry of molrs ``RegularGrid``.\n\nColumns of ``vectors`` are the edge of one voxel along each axis.\n``origin`` is the corner of voxel 0. Where the stored value sits, corner\nor center, is the block's ``sample``, not this geometry. ``unit`` is a\nlength override; absent means ``meta.units`` length.",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "origin": {
          "items": {},
          "title": "Origin",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "vectors": {
          "items": {},
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "vectors"
      ],
      "title": "MeshModel",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Named columns sharing one count, plus an optional structural shape.\n\nA plain table has implicit shape ``[count]``. A volumetric block declares\n``structural_shape = (nx, ny, nz)`` with ``nx * ny * nz == count`` -- the\nonly thing that makes a flat column reshapable after a roundtrip.\n\nA block imposes no meaning on its column names.",
  "properties": {
    "columns": {
      "additionalProperties": {
        "$ref": "#/$defs/ColumnModel"
      },
      "title": "Columns",
      "type": "object"
    },
    "count": {
      "minimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "mesh": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeshModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sample": {
      "anyOf": [
        {
          "enum": [
            "corner",
            "center"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample"
    },
    "structural_shape": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structural Shape"
    }
  },
  "required": [
    "count"
  ],
  "title": "BlockModel",
  "type": "object"
}
