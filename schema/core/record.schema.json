          "type": "string"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
