            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "dtype"
      ],
      "title": "ArrayModel",
      "type": "object"
    },
    "ArrayNodeModel": {
      "description": "An array of an unrecognised subtree: its values and its attributes.",
