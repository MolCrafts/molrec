      "properties": {
        "version": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Version",
          "type": "array"
        }
      },
      "required": [
        "version"
      ],
      "title": "ModuleModel",
      "type": "object"
    },
    "NodeModel": {
      "description": "An unrecognised group, carried through verbatim.\n\nA reader preserves sections it does not interpret: their attributes,\narrays and child groups come back exactly as they were read, and a writer\nlays them down again. Nothing in them is interpreted.",
      "properties": {
        "arrays": {
          "additionalProperties": {
            "$ref": "#/$defs/ArrayNodeModel"
          },
          "title": "Arrays",
          "type": "object"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "groups": {
