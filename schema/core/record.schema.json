        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        }
      },
      "title": "FrameModel",
      "type": "object"
    },
    "MetaModel": {
      "additionalProperties": true,
      "description": "The record's identity document.\n\n``extra=\"allow\"`` is not convenience -- it is the preserve-the-unknown\ninvariant: a reader must keep keys it does not recognize.\n\n``molrec_version`` is stamped by every writer (:func:`stamp_version`). A\nreader validates it only when present: absent is a store written before\nversion 1, read best-effort; present must be an integer in\n``1..=MOLREC_VERSION`` -- ``null``, ``0``, a string, a float or a newer\nversion is refused. Identity of a record is the ``*.mrec`` path suffix\nplus a Zarr root, not this key.\n\n``record_id`` and ``content_hash`` are optional provenance, like\n``creator``, ``author``, ``created_at`` and ``source``.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "creator": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreatorModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modules": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ModuleModel"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modules"
        },
        "molrec_version": {
          "description": "Absent on a store written before version 1; never null.",
          "maximum": 1,
          "minimum": 1,
          "title": "Molrec Version",
          "type": "integer"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "MetaModel",
      "type": "object"
    },
    "MetaSeriesModel": {
      "description": "One per-step meta key, declared once for the whole sequence.\n\n``dtype`` is a tag from the closed per-step set (:data:`META_TAGS`): a\nscalar dtype, ``f64x3`` / ``bool3`` / ... for a fixed-width vector,\n``json`` for one JSON document per step. The tag is what makes the value\nexact: two runs both handing back ``1`` are not the same run if one wrote\ni32 and the other u64, and nothing in the value says which.\n\n``fill`` is the only thing that lets a frame omit the key. A key declared\nwithout one must be supplied by every frame -- there is **no implicit\nNaN**, so a gap a producer did not declare is refused rather than\ninvented. The fill is coerced to the tag (:func:`coerce_meta_value`),\nmaterialized into the array at the omitting step *and* recorded in the\npinned sequence declaration (``trajectory`` attribute\n``sequence_schema``), so a reader that opens the declaration can hand it\nback.\n\nA fill is declared by **stating** it: ``fill=None`` on a ``json`` key\ndeclares the JSON document ``null``, while leaving ``fill`` out declares\nno fill (:attr:`has_fill`). ``null`` is a fill for ``json`` only.",
      "properties": {
        "dtype": {
          "enum": [
            "bool",
            "i32",
            "i64",
            "u32",
            "u64",
            "f64",
            "string",
            "json",
            "bool3",
            "i32x3",
            "i64x3",
            "u32x3",
            "u64x3",
            "f64x3",
            "f64x6",
            "f64x9"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "fill": {
          "description": "The value an omitting frame is completed with, in the typed JSON form of its tag. Absent means no fill; null is a fill only for json.",
          "title": "Fill"
        }
      },
      "required": [
        "dtype"
      ],
      "title": "MetaSeriesModel",
      "type": "object"
    },
    "MethodModel": {
      "additionalProperties": true,
      "description": "The scientific / training context document (``docs/spec/method.md``).\n``type``, ``description`` and ``engine.name`` are required whenever the\nsection exists; a ``workflow`` names its stages in ``order`` and gives\neach one its own method document in ``stages``.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "engine": {
          "$ref": "#/$defs/EngineModel"
        },
        "order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "stages": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/MethodModel"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stages"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description",
        "engine"
      ],
      "title": "MethodModel",
      "type": "object"
    },
    "ModuleModel": {
      "additionalProperties": true,
