      "type": "object"
    },
    "AuthorModel": {
      "additionalProperties": true,
      "description": "The person or group responsible for the record.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
