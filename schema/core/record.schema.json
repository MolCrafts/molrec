    "ForceFieldModel": {
      "additionalProperties": true,
      "description": "The ``forcefield`` section: the document and one table per style.\n\nEvery field but ``tables`` is the document -- the group's attribute map,\nunknown keys preserved (``extra=\"allow\"``). ``tables`` maps a block name to\nits style table; a table no style names is kept as unknown content.\nLinking a system's types to these rows is by name and is never refused\nhere (``docs/spec/forcefield.md``, linking a system).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForceFieldSourceModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "special_bonds": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpecialBondsModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "styles": {
          "items": {
            "$ref": "#/$defs/StyleModel"
          },
          "title": "Styles",
          "type": "array"
        },
        "tables": {
          "additionalProperties": {
            "$ref": "#/$defs/BlockModel"
          },
          "title": "Tables",
          "type": "object"
        },
        "units": {
          "$ref": "#/$defs/ForceFieldUnitsModel"
        }
      },
      "required": [
        "name",
        "units"
      ],
      "title": "ForceFieldModel",
      "type": "object"
    },
    "ForceFieldSourceModel": {
