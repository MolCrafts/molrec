      "required": [
        "name"
      ],
      "title": "AuthorModel",
      "type": "object"
    },
    "BlockModel": {
      "additionalProperties": true,
      "description": "Named columns sharing one count, plus an optional structural shape.\n\nA plain table has implicit shape ``[count]``. A volumetric block declares\n``structural_shape = (nx, ny, nz)`` with ``nx * ny * nz == count`` -- the\nonly thing that makes a flat column reshapable after a roundtrip.\n\nA block imposes no meaning on its column names beyond one: a\n:data:`canonical <CANONICAL_COLUMNS>` key has one dtype and shape wherever\nit appears.",
      "properties": {
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/ColumnModel"
          },
          "title": "Columns",
          "type": "object"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "structural_shape": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Shape"
        }
      },
      "required": [
        "count"
      ],
      "title": "BlockModel",
      "type": "object"
    },
    "BoxModel": {
      "description": "A frame's cell: its geometry plus whether there is a cell at all.\n\n``cell_defined`` is not periodicity -- ``boundary`` says which axes wrap,\n``cell_defined`` says whether there is a cell at all. Absent means\n``True``; a writer records it only to say ``False``. An undefined cell's\n``vectors`` mean nothing: a writer writes the identity and a reader\nignores what it finds (:func:`resolve_cell`).",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "cell_defined": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Defined"
        },
        "origin": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "vectors": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "vectors"
      ],
      "title": "BoxModel",
      "type": "object"
    },
    "BoxUpdateModel": {
      "description": "The cell as of one frame ordinal: its geometry, never its definedness.\n\n``step_index`` is a frame **ordinal** -- a position in the sequence -- and\nnever a step number. Whether there is a cell at all is the section's one\nflag (:attr:`TrajectoryBoxModel.cell_defined`), so an update cannot\ndisagree with it.",
      "properties": {
        "box": {
          "$ref": "#/$defs/CellModel"
        },
        "step_index": {
          "minimum": 0,
          "title": "Step Index",
          "type": "integer"
        }
      },
      "required": [
        "step_index",
        "box"
      ],
      "title": "BoxUpdateModel",
      "type": "object"
    },
    "CellModel": {
      "description": "The geometry of a triclinic cell. Columns of ``vectors`` are the lattice\nvectors.\n\nWhat a cell's absent parts mean depends on whether there is a cell at\nall, which the owner says -- a frame's :class:`BoxModel`, or a\ntrajectory's :class:`TrajectoryBoxModel` for every update at once -- so\nthe owner resolves them (:func:`resolve_cell`). On its own a cell only\nholds its parts to their shapes and to ``f64``.",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "origin": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "vectors": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "vectors"
      ],
      "title": "CellModel",
      "type": "object"
    },
    "ColumnModel": {
      "description": "A typed N-dimensional array, optionally nullable.\n\nThe leading axis length is the owning block's count; trailing axes are\nper-entity structure, so ``Float[count][3]`` is one column, not three.\n\n``validity`` is the column's mask: one flag per row, ``True`` where the\nrow holds a value and ``False`` where it holds none (the value stored\nunder a null row is carried as written and means nothing). ``None`` --\nno mask -- means every row is valid, and an all-``True`` mask *is* no\nmask: it is normalized to ``None``, so the two spellings of \"nothing is\nnull\" are one model.\n\n``precision`` is the column's declared precision (``f64`` only). Like\n``BoxModel`` materializing its defaults, a validated model holds the\n**stored** values -- rounded to the precision's binary grid\n(:func:`molrec.precision.quantize`) -- which is what a writer stores and\na reader hands back. A model built from a store (:data:`STORED`) keeps\nthe values exactly as stored.",
      "if": {
        "properties": {
          "precision": {
            "type": "number"
          }
        },
        "required": [
          "precision"
        ]
      },
      "properties": {
        "dtype": {
          "enum": [
            "f64",
            "i8",
            "i16",
            "i32",
            "i64",
            "u8",
            "u16",
            "u32",
            "u64",
            "bool",
            "string",
            "c64",
            "c128"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1.0715086071862673e+301,
              "minimum": 9.332636185032189e-302,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        },
        "validity": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validity"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "dtype",
        "shape"
      ],
      "then": {
        "properties": {
          "dtype": {
            "const": "f64"
          }
        }
      },
      "title": "ColumnModel",
      "type": "object"
    },
