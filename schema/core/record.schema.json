                "$ref": "#/$defs/SequenceBlockModel"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocks"
        },
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrajectoryBoxModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
