        "frames": {
          "items": {
            "$ref": "#/$defs/FrameModel"
          },
          "title": "Frames",
          "type": "array"
        },
        "meta": {
          "additionalProperties": {
            "$ref": "#/$defs/MetaSeriesModel"
          },
          "title": "Meta",
          "type": "object"
        },
        "step": {
          "items": {
            "type": "integer"
          },
          "title": "Step",
          "type": "array"
        },
        "time": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        }
      },
      "required": [
        "step"
      ],
      "title": "TrajectoryModel",
      "type": "object"
    }
  },
