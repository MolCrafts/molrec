    "TrajectoryBoxModel": {
      "description": "The cell section: one cell, indexed by the ordinals it changed at.\n\nA fixed-cell run holds exactly one update. There is no absence marker\nhere: once a run states a cell every later frame resolves to the most\nrecent one, so a frame that drops its cell mid-run reads back carrying the\nprevious cell.\n\n``cell_defined`` is the section's flag, stated once for every update;\neach update's absent parts are resolved against it (:func:`resolve_cell`).",
      "properties": {
        "cell_defined": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Defined"
        },
        "updates": {
          "items": {
            "$ref": "#/$defs/BoxUpdateModel"
          },
          "minItems": 1,
          "title": "Updates",
          "type": "array"
        }
      },
      "required": [
        "updates"
      ],
      "title": "TrajectoryBoxModel",
      "type": "object"
    },
    "TrajectoryModel": {
      "additionalProperties": false,
      "description": "An ordered sequence of frames -- the time evolution of the system.\n\nThis is the *logical* content, the thing a reader hands back. The physical\nform is the binding's: one CSR row range per section update, a sparse\nindex of the ordinals a section changed at, and each section written again\nonly when it changed. Two conforming stores of one trajectory are expected\nto differ byte for byte, so none of that appears here.\n\nTwo integers index a trajectory and they are not the same one. A frame's\n**ordinal** is its position in ``frames``; its **step number** is the\nproducer's own iteration counter at ``step[ordinal]``, which may start\nanywhere and may skip values.\n\n``blocks`` and ``meta`` are the pinned declaration. ``blocks`` may be left\nunstated, in which case it is derived from the frames (first presentation\nwins); stated, every frame is held to it. After validation every frame\ncarries every block's carried-forward state (see :class:`BlockState`) and\nevery declared meta key, which is also what a reader hands back.",
      "properties": {
        "blocks": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SequenceBlockModel"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocks"
        },
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrajectoryBoxModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FrameModel"
          },
          "title": "Frames",
          "type": "array"
        },
        "meta": {
          "additionalProperties": {
            "$ref": "#/$defs/MetaSeriesModel"
          },
          "title": "Meta",
          "type": "object"
        },
        "step": {
          "items": {
            "type": "integer"
          },
          "title": "Step",
          "type": "array"
        },
        "time": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        }
      },
      "required": [
        "step"
      ],
      "title": "TrajectoryModel",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "anyOf": [
