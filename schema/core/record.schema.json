    "SequenceBlockModel": {
      "additionalProperties": true,
      "description": "One block's declaration: its columns and, when it is a grid, its shape.\n\nA block that declares ``structural_shape`` is a fixed-size object: every\nupdate of it holds exactly ``prod(structural_shape)`` rows, and a writer\nrefuses one that does not.",
      "properties": {
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/SequenceColumnModel"
          },
          "title": "Columns",
          "type": "object"
        },
        "structural_shape": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Shape"
        }
      },
      "title": "SequenceBlockModel",
      "type": "object"
    },
    "SequenceColumnModel": {
      "description": "One column's type in a sequence declaration.\n\nA column is fixed for the run by its ``dtype`` -- the same closed\nvocabulary as :class:`ColumnModel` -- and its ``trailing`` axes, the\nper-entity structure after the leading count axis. A ``Float[count][3]``\ncolumn declares ``trailing = [3]``; a scalar column declares\n``trailing = []``.\n\n``nullable`` says the column may carry a validity mask. It is a union over\nthe run -- a column masked in any frame is nullable for all of them -- and\na frame that masks a column the declaration pins non-nullable is refused:\nlanding its values without the mask would lose which rows hold nothing.\n\n``precision`` is the column's declared precision (``f64`` only): on a\ntrajectory the declaration is the only place it is stated, and every\nframe's values are rounded to it.",
      "if": {
        "properties": {
          "precision": {
            "type": "number"
          }
        },
        "required": [
          "precision"
        ]
      },
      "properties": {
        "dtype": {
          "enum": [
            "f64",
            "i8",
            "i16",
            "i32",
            "i64",
            "u8",
            "u16",
            "u32",
            "u64",
            "bool",
            "string",
            "c64",
            "c128"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "description": "Whether the column may carry a validity mask; written only when true.",
          "title": "Nullable",
          "type": "boolean"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1.0715086071862673e+301,
              "minimum": 9.332636185032189e-302,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The column's declared precision (f64 only); written only when declared.",
          "title": "Precision"
        },
        "trailing": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Trailing",
          "type": "array"
        }
      },
      "required": [
        "dtype"
      ],
      "then": {
        "properties": {
          "dtype": {
            "const": "f64"
          }
        }
      },
      "title": "SequenceColumnModel",
      "type": "object"
    },
