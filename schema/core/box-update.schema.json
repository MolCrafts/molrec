{
  "$defs": {
    "BoxModel": {
      "description": "The triclinic cell. Columns of ``vectors`` are the lattice vectors.\n\nA box belongs to a frame, so fixed-cell and variable-cell runs are both\nnatural -- each frame in a trajectory carries its own.\n\n``cell_defined`` is not periodicity -- ``boundary`` says which axes wrap,\n``cell_defined`` says whether there is a cell at all. Absent means\n``True``; a writer records it only to say ``False``.",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "cell_defined": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Defined"
        },
        "origin": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "vectors": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "vectors"
      ],
      "title": "BoxModel",
      "type": "object"
    }
  },
  "description": "The cell as of one frame ordinal.\n\n``step_index`` is a frame **ordinal** -- a position in the sequence -- and\nnever a step number.",
  "properties": {
    "box": {
      "$ref": "#/$defs/BoxModel"
    },
    "step_index": {
      "minimum": 0,
      "title": "Step Index",
      "type": "integer"
    }
  },
  "required": [
    "step_index",
    "box"
  ],
  "title": "BoxUpdateModel",
  "type": "object"
}
