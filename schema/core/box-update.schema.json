{
  "$defs": {
    "BoxModel": {
      "description": "The triclinic cell. Columns of ``vectors`` are the lattice vectors.\n\nA box belongs to a frame, so fixed-cell and variable-cell runs are both\nnatural -- each frame in a trajectory carries its own.",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "origin": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "vectors": {
          "items": {},
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "vectors"
      ],
      "title": "BoxModel",
      "type": "object"
    }
  },
  "description": "The cell as of one frame ordinal.\n\n``step_index`` is a frame **ordinal** -- a position in the sequence -- and\nnever a step number.",
  "properties": {
    "box": {
      "$ref": "#/$defs/BoxModel"
    },
    "step_index": {
      "minimum": 0,
      "title": "Step Index",
      "type": "integer"
    }
  },
  "required": [
    "step_index",
    "box"
  ],
  "title": "BoxUpdateModel",
  "type": "object"
}
